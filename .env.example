# Copia este archivo a .env y rellena tus valores
GEMINI_API_KEY=tu_api_key_aqui

# Modelo del orquestador (back office): propone Intents + ejecuta policies
GEMINI_MODEL=gemini-3.6-flash
# Modelo del asistente frontal (PR): con el que habla el usuario, debe ser rápido
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_TEMPERATURE=0.2

# --- Credentials de providers (para conectar connectors) ---
# Google OAuth 2.0 (Gmail, Drive, Calendar, YouTube, Analytics, Search Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_REDIRECT_URI=http://localhost:8000/oauth/callback

# Microsoft OAuth 2.0 (Outlook, OneDrive, Excel, Teams, SharePoint)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REFRESH_TOKEN_=
MICROSOFT_TENANT_ID=

# OpenAI (para OpenAIAdapter: embeddings/imagenes/complegions)
OPENAI_API_KEY=

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# HubSpot OAuth
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_REFRESH_TOKEN=
HUBSPOT_PORTAL_ID=

# Meta (Facebook / Instagram): Graph API
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_PAGE_ID=
META_IG_USER_ID=

# Slack
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=

# WhatsApp Business (Meta)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Telegram
TELEGRAM_BOT_TOKEN=

# GitHub
GITHUB_TOKEN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Shopify
SHOPIFY_API_KEY=
SHOPIFY_PASSWORD=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_STORE_NAME=

# WordPress
WORDPRESS_APP_USERNAME=
WORDPRESS_APP_PASSWORD=
WORDPRESS_SITE_URL=

# Supabase
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# PostgreSQL
POSTGRES_DSN=

# Redis
REDIS_URL=

# Vercel
VERCEL_TOKEN=

# Cloudflare
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# n8n
N8N_API_KEY=
N8N_BASE_URL=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# DocuSign
DOCUSIGN_CLIENT_ID=
DOCUSIGN_CLIENT_SECRET=
DOCUSIGN_PRIVATE_KEY=

# Project management (Notion, Linear, ClickUp, Asana, Jira)
NOTION_API_KEY=
LINEAR_API_KEY=
CLICKUP_API_KEY=
ASANA_TOKEN=
JIRA_TOKEN=
JIRA_EMAIL=

# Directorio para credenciales en disco (encriptadas). Opcional.
CONNECTOR_CRED_DIR=.credentials

# Clave de encriptación para credenciales (32 bytes base64 url-safe para Fernet)
# Si no se establece, se genera una y se advierte que debe guardarse en .env para producción
CREDENTIAL_ENCRYPTION_KEY=

# Seguridad: UNICO disparador del allow-all (default false). ENV=dev por si solo
# NO abre la policy. Con false, un tenant sin enabled_capabilities es deny.
DEV_ALLOW_ALL=false
