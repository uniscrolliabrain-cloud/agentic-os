# ============================================================
# Agentic OS — Git Ignore
# ============================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so

# ---------- Virtual environments ----------
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ---------- Environment / secrets ----------
.env
.env.*
.env*
!.env.example
.credentials/
*.pem
*.key

# Streamlit secrets — NEVER commit API keys
.streamlit/secrets.toml

# ---------- Packaging / distribution ----------
build/
dist/
*.egg-info/
.eggs/
*.egg
*.whl
.Python
MANIFEST

# ---------- Test / coverage ----------
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# ---------- Type checking ----------
.mypy_cache/

# ---------- Linting / formatting ----------
.ruff_cache/

# ---------- IDE / editors ----------
.vscode/
.idea/
*.swp
*.swo

# ---------- OS ----------
.DS_Store
Thumbs.db
Desktop.ini

# ---------- Node / Frontend ----------
node_modules/
frontend/dist/
frontend/.vite/

# ---------- Temporary artifacts ----------
_probe_im.py
MASTER_PLAN.MD
tests/MASTER_PLAN.MD
estrategia_consolidada.md
ontology_prompt_final.md
ontology_prompt_finalv2.md
data/

# ---------- Local runtime logs ----------
*.log
*.err.log
.aider*
